# --- LLM (omit ANTHROPIC_API_KEY to run fully offline with the deterministic stub) ---
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto            # auto | anthropic | fake
ANTHROPIC_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=               # defaults to ANTHROPIC_MODEL; a cheaper/faster model is fine for judging
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# --- retrieval ---
EMBEDDING_BACKEND=tfidf      # tfidf (offline) | sbert  (pip install -r requirements-optional.txt)
RERANKER_BACKEND=lexical     # lexical (offline) | cross-encoder
CONFIDENCE_THRESHOLD=0.45    # calibrate with: make calibrate  (re-tune whenever you change backends!)

# --- infra ---
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318    # unset to disable export (IDs still appear in logs)
# OTEL_CONSOLE=1             # print spans to stdout instead
